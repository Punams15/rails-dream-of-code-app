
<h1>Admin Dashboard</h1>

<h2>Current Trimester</h2>
<h3><%= "#{@current_trimester.term} - #{@current_trimester.year}" %></h3>
<ul>
  <% @current_trimester.courses.each do |course| %>
    <li><a href="#"><%= course.coding_class.title %></a></li>
  <% end %>
</ul>

<h2>Upcoming Trimester</h2>
<h3><%= "#{@upcoming_trimester.term} - #{@upcoming_trimester.year}" %></h3>
<ul>
  <% @upcoming_trimester.courses.each do |course| %>
    
    <li><%= link_to course.coding_class.title, course_path(course) %></li>
  <% end %>
</ul>

#The important lines for tests are the <h3> lines — they match the strings  tests expect.

#Make sure I use #{} inside <%= %> for interpolation.

#Replacing this <li><a href="#"><%= course.coding_class.title %></a></li> to  <li><%= link_to course.coding_class.title, course_path(course) %></li> 
#course_path(course) generates the URL /courses/:id automatically.
#Clicking it will go to CoursesController#show and display enrolled students.